	partition DimEquipo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(
				        File.Contents(RutaDatos & "\DimEquipo.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Equipo", string}, {"Denominacion", string}, {"Area", string}, {"Linea", string}, {"Criticidad", string}, {"Familia", string}, {"Fabricante", string}, {"Anio", Int64.Type}, {"PesoFalla", type number}})
				in
				    Tipos

	queryGroup: '02 · Dimensiones'

	annotation PBI_ResultType = Table
