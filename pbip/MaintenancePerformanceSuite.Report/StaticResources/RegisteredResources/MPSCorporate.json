{
  "name": "MPS Corporate",
  "dataColors": [
    "#2F6FED",
    "#0E1C33",
    "#D97706",
    "#12805C",
    "#6941C6",
    "#B54708",
    "#B42318",
    "#667085",
    "#7BA4F5",
    "#4C6A9B"
  ],
  "background": "#F4F6FA",
  "foreground": "#101828",
  "tableAccent": "#2F6FED",
  "good": "#12805C",
  "neutral": "#B54708",
  "bad": "#B42318",
  "maximum": "#0E1C33",
  "center": "#2F6FED",
  "minimum": "#EEF2F8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#0E1C33"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0E1C33"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#101828"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 30,
      "color": "#0E1C33"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#0E1C33"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E9F2"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Subtle"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0E1C33"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#101828"
              }
            },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#5A6473"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E4E9F2"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#5A6473"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "position": "Bottom",
            "labelColor": {
              "solid": {
                "color": "#5A6473"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0E1C33"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5A6473"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}