/// Maestro de equipos. Fuente: SAP PM · IH08 / IE03. La criticidad gobierna la priorización de todo el sistema.
table DimEquipo
	lineageTag: 66dcc1f4-9383-5391-a137-74cd27d77577

	/// Código de equipo SAP.
	column Equipo
		dataType: string
